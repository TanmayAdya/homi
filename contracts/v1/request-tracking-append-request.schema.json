{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-at-home.example/contracts/v1/request-tracking-append-request.schema.json",
  "title": "Request Tracking Append Request v1",
  "description": "Private manually reported request history. No submission, receipt, approval or policy verification is performed. Unicode-aware regex and asserted date formats are required. Runtime also validates exact context, event IDs, contiguous revisions, nondecreasing case revisions and recorded times, and occurredOn not after recordedAt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "expectedCaseRevision",
    "programId",
    "expectedRequestRevision",
    "update"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "caseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\uD800-\\uDFFF])(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"
    },
    "expectedCaseRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "programId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\uD800-\\uDFFF])(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"
    },
    "expectedRequestRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "updateId",
        "status",
        "occurredOn",
        "source",
        "note",
        "nextAction",
        "responsibleParty",
        "followUpOn"
      ],
      "properties": {
        "updateId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "status": {
          "enum": [
            "preparing",
            "submitted",
            "received",
            "needs_information",
            "approved",
            "denied",
            "withdrawn"
          ]
        },
        "occurredOn": {
          "type": "string",
          "format": "date",
          "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$(?![\\s\\S])"
        },
        "source": {
          "enum": [
            "self_report",
            "program_contact",
            "document"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\u2028\\u2029\\uD800-\\uDFFF])(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"
        },
        "nextAction": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 250,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\u2028\\u2029\\uD800-\\uDFFF])(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"
        },
        "responsibleParty": {
          "enum": [
            null,
            "resident",
            "caregiver",
            "program",
            "clinician",
            "contractor",
            "other"
          ]
        },
        "followUpOn": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$(?![\\s\\S])"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "nextAction": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "responsibleParty": {
                "type": "null"
              },
              "followUpOn": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "responsibleParty": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
