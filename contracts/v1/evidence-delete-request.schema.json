{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-at-home.example/contracts/v1/evidence-delete-request.schema.json",
  "title": "Delete private evidence request v1",
  "description": "Delete an active private asset after checking case, catalog and asset revisions. The catalog and asset revisions advance; case revision is unchanged. Reload the active catalog after an uncertain response; retakes after deletion use a fresh ID.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "expectedCaseRevision",
    "expectedCatalogRevision",
    "evidenceId",
    "expectedEvidenceRevision"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "caseId": {
      "$ref": "form-answers.schema.json#/$defs/id"
    },
    "expectedCaseRevision": {
      "$ref": "form-answers.schema.json#/$defs/positiveRevision"
    },
    "expectedCatalogRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "evidenceId": {
      "$ref": "form-answers.schema.json#/$defs/id"
    },
    "expectedEvidenceRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740990
    }
  }
}
