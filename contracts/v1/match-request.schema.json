{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-at-home.example/contracts/v1/match-request.schema.json",
  "title": "Matching request v1",
  "description": "POST /v1/match-case with a bearer session. The server loads the authorized saved case; the client cannot supply ownership or policy decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "expectedCaseRevision"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "caseId": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "expectedCaseRevision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
  }
}
