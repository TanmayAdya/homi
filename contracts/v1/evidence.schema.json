{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-at-home.example/contracts/v1/evidence.schema.json",
  "title": "Private evidence catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "caseRevision",
    "catalogRevision",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "caseId": {
      "$ref": "form-answers.schema.json#/$defs/id"
    },
    "caseRevision": {
      "$ref": "form-answers.schema.json#/$defs/positiveRevision"
    },
    "catalogRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "evidence": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/descriptor"
      }
    }
  },
  "description": "Private metadata only. Runtime requires unique evidence IDs, matching case IDs, width\u00d7height<=16000000 and capturedAt<=preparedAt. No public URL or storage path is exposed.",
  "$defs": {
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "evidenceRevision",
        "caseId",
        "findingId",
        "mediaType",
        "byteLength",
        "sha256",
        "width",
        "height",
        "capturedAt",
        "preparedAt",
        "processingVersion"
      ],
      "properties": {
        "evidenceId": {
          "$ref": "form-answers.schema.json#/$defs/id"
        },
        "evidenceRevision": {
          "$ref": "form-answers.schema.json#/$defs/positiveRevision"
        },
        "caseId": {
          "$ref": "form-answers.schema.json#/$defs/id"
        },
        "findingId": {
          "$ref": "form-answers.schema.json#/$defs/id"
        },
        "mediaType": {
          "const": "image/png"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25165824
        },
        "sha256": {
          "$ref": "form-answers.schema.json#/$defs/digest"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "capturedAt": {
          "anyOf": [
            {
              "$ref": "form-answers.schema.json#/$defs/instant"
            },
            {
              "type": "null"
            }
          ]
        },
        "preparedAt": {
          "$ref": "form-answers.schema.json#/$defs/instant"
        },
        "processingVersion": {
          "const": "evidence-png-v1"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "expectedEvidenceRevision",
        "reviewedForExport"
      ],
      "properties": {
        "evidenceId": {
          "$ref": "form-answers.schema.json#/$defs/id"
        },
        "expectedEvidenceRevision": {
          "$ref": "form-answers.schema.json#/$defs/positiveRevision"
        },
        "reviewedForExport": {
          "const": true
        }
      }
    }
  }
}
