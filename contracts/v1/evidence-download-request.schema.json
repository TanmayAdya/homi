{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-at-home.example/contracts/v1/evidence-download-request.schema.json",
  "title": "Download private evidence request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "expectedCaseRevision",
    "expectedCatalogRevision",
    "evidenceId",
    "expectedEvidenceRevision"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "caseId": {
      "$ref": "form-answers.schema.json#/$defs/id"
    },
    "expectedCaseRevision": {
      "$ref": "form-answers.schema.json#/$defs/positiveRevision"
    },
    "expectedCatalogRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "evidenceId": {
      "$ref": "form-answers.schema.json#/$defs/id"
    },
    "expectedEvidenceRevision": {
      "$ref": "form-answers.schema.json#/$defs/positiveRevision"
    }
  }
}
