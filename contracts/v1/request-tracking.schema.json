{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-at-home.example/contracts/v1/request-tracking.schema.json",
  "title": "Request Tracking v1",
  "description": "Private manually reported request history. No submission, receipt, approval or policy verification is performed. Unicode-aware regex and asserted date formats are required. Runtime also validates exact context, event IDs, contiguous revisions, nondecreasing case revisions and recorded times, and occurredOn not after recordedAt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "caseRevision",
    "programId",
    "requestRevision",
    "provenance",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "caseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\uD800-\\uDFFF])(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"
    },
    "caseRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "programId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\uD800-\\uDFFF])(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"
    },
    "requestRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "provenance": {
      "const": "user_reported"
    },
    "events": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "updateId",
          "status",
          "occurredOn",
          "source",
          "note",
          "nextAction",
          "responsibleParty",
          "followUpOn",
          "revision",
          "caseRevision",
          "recordedAt"
        ],
        "properties": {
          "updateId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
          },
          "status": {
            "enum": [
              "preparing",
              "submitted",
              "received",
              "needs_information",
              "approved",
              "denied",
              "withdrawn"
            ]
          },
          "occurredOn": {
            "type": "string",
            "format": "date",
            "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$(?![\\s\\S])"
          },
          "source": {
            "enum": [
              "self_report",
              "program_contact",
              "document"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\u2028\\u2029\\uD800-\\uDFFF])(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"
          },
          "nextAction": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 250,
            "pattern": "^(?![\\s\\S]*[\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\u2028\\u2029\\uD800-\\uDFFF])(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"
          },
          "responsibleParty": {
            "enum": [
              null,
              "resident",
              "caregiver",
              "program",
              "clinician",
              "contractor",
              "other"
            ]
          },
          "followUpOn": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$(?![\\s\\S])"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "caseRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$(?![\\s\\S])"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "nextAction": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "responsibleParty": {
                  "type": "null"
                },
                "followUpOn": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "responsibleParty": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    }
  }
}
