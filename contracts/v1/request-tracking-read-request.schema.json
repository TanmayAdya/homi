{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-at-home.example/contracts/v1/request-tracking-read-request.schema.json",
  "title": "Request Tracking Read Request v1",
  "description": "Private manually reported request history. No submission, receipt, approval or policy verification is performed. Unicode-aware regex and asserted date formats are required. Runtime also validates exact context, event IDs, contiguous revisions, nondecreasing case revisions and recorded times, and occurredOn not after recordedAt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "expectedCaseRevision",
    "programId"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "caseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\uD800-\\uDFFF])(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"
    },
    "expectedCaseRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "programId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\uD800-\\uDFFF])(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"
    }
  }
}
