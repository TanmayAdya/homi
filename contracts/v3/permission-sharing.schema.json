        },
        "grantorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$"
        },
        "recipientId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "role": {
          "enum": [
            "viewer",
            "helper"
          ]
        },
        "scope": {
          "$ref": "#/$defs/ShareScope"
        },
        "permissionRevision": {
          "type": "integer",
