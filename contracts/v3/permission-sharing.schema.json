          "type": "array",
          "maxItems": 36,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$"
          }
        }
      }
    },
    "SharingLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\s\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069](?:[^\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069]*[^\\s\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069])?$",
      "description": "Optional owner-typed label, trimmed, at most 80 characters. Not a verified identity."
    }
  },
  "description": "Raw profile, photos, intake, forms, PDFs, exports, measurements and unselected programs are excluded. Viewer never grants helper notes. Relationship confers no professional authority. Optional labels are owner-typed: recipientLabel is returned only to the owner, ownerLabel only when a list/review request opts in with includeLabels; legacy shapes stay exact."
}
