{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:safeathome:v3:program-progress-request",
  "title": "Private program progress v3 request",
  "description": "Server parsers additionally enforce trimmed Unicode text, real calendar dates, linked references, cross-field rules, revision ordering, idempotency, ownership and quotas. Strict v1 contracts are unchanged.",
  "oneOf": [
    {
      "$ref": "#/$defs/read"
    },
    {
      "$ref": "#/$defs/save"
    },
    {
      "$ref": "#/$defs/history"
    }
  ],
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "programId",
        "findingId",
        "formId",
        "title",
        "kind",
        "state",
        "responsiblePerson",
        "dueOn",
        "basedOnCaseRevision",
        "basedOnRuleVersion",
        "revision",
        "sourceEventId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
        },
        "programId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "findingId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "formId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
        },
        "kind": {
          "enum": [
            "profile",
            "room_review",
            "documents",
            "contact",
            "draft_review",
            "follow_up",
            "other"
          ]
        },
        "state": {
          "enum": [
            "pending",
            "in_progress",
            "blocked",
            "completed",
            "cancelled"
          ]
        },
        "responsiblePerson": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "dueOn": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "basedOnCaseRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "basedOnRuleVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sourceEventId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "referral": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "providerId"
          ],
          "properties": {
            "providerId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "imported": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceTaskId",
                "sourceHash",
                "contactNote",
                "original"
              ],
              "properties": {
                "sourceTaskId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "sourceHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "contactNote": {
                  "type": "string",
                  "maxLength": 500
                },
                "original": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "providerId",
                    "title",
                    "responsible",
                    "dueDate",
                    "findingId",
                    "createdAt",
                    "completedAt"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "providerId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "responsible": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "dueDate": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date"
                    },
                    "findingId": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 200
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "completedAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "updateId",
        "status",
        "occurredOn",
        "source",
        "note",
        "nextAction",
        "responsibleParty",
        "followUpOn"
      ],
      "properties": {
        "updateId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "preparing",
            "submitted",
            "received",
            "needs_information",
            "approved",
            "denied",
            "withdrawn"
          ]
        },
        "occurredOn": {
          "type": "string",
          "format": "date",
          "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "source": {
          "enum": [
            "self_report",
            "program_contact",
            "document"
          ]
        },
        "note": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "nextAction": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 250
            },
            {
              "type": "null"
            }
          ]
        },
        "responsibleParty": {
          "enum": [
            null,
            "resident",
            "caregiver",
            "program",
            "clinician",
            "contractor",
            "other"
          ]
        },
        "followUpOn": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "caseId",
        "offset",
        "limit",
        "expectedProgressRevision",
        "expectedCaseRevision",
        "expectedHistoryVersion"
      ],
      "properties": {
        "schemaVersion": {
          "const": "3"
        },
        "caseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "expectedProgressRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedCaseRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedHistoryVersion": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "includeReferrals": {
          "const": true
        }
      }
    },
    "save": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "caseId",
        "expectedCaseRevision",
        "expectedProgressRevision",
        "mutationId",
        "operation"
      ],
      "properties": {
        "schemaVersion": {
          "const": "3"
        },
        "caseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
        },
        "expectedCaseRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expectedProgressRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mutationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
        },
        "operation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "programId"
              ],
              "properties": {
                "type": {
                  "const": "track_program"
                },
                "programId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "task",
                "expectedTaskRevision"
              ],
              "properties": {
                "type": {
                  "const": "put_task"
                },
                "task": {
                  "$ref": "#/$defs/task"
                },
                "expectedTaskRevision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "eventId"
              ],
              "properties": {
                "type": {
                  "const": "dismiss_proposal"
                },
                "eventId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "programId",
                "update"
              ],
              "properties": {
                "type": {
                  "const": "report_status"
                },
                "programId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
                },
                "update": {
                  "$ref": "#/$defs/update"
                }
              }
            }
          ]
        },
        "includeReferrals": {
          "const": true
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "caseId",
        "offset",
        "limit",
        "expectedProgressRevision",
        "expectedCaseRevision",
        "programId",
        "expectedHistoryVersion"
      ],
      "properties": {
        "schemaVersion": {
          "const": "3"
        },
        "caseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "expectedProgressRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedCaseRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "programId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
        },
        "expectedHistoryVersion": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "includeReferrals": {
          "const": true
        }
      }
    }
  }
}
