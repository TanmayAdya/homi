{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owner-reviewed shared collaboration v3",
  "description": "Canonical tasks remain in progress. Assignments bind verified account IDs. Proposals are not reported statuses until an owner review. Sensitive fields and imported referral notes are excluded.",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskIds",
        "allowTaskProgress",
        "allowStatusProposals"
      ],
      "properties": {
        "taskIds": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true
        },
        "allowTaskProgress": {
          "type": "boolean"
        },
        "allowStatusProposals": {
          "type": "boolean"
        }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "updateId",
        "status",
        "occurredOn",
        "source",
        "note",
        "nextAction",
        "responsibleParty",
        "followUpOn"
      ],
      "properties": {
        "updateId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "status": {
          "enum": [
            "preparing",
            "submitted",
            "received",
            "needs_information",
            "approved",
            "denied",
            "withdrawn"
          ]
        },
        "occurredOn": {
          "type": "string",
          "format": "date"
        },
        "source": {
          "enum": [
            "self_report",
            "program_contact",
            "document"
          ]
        },
        "note": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "nextAction": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 250
            },
            {
              "type": "null"
            }
          ]
        },
        "responsibleParty": {
          "anyOf": [
            {
              "enum": [
                "resident",
                "caregiver",
                "program",
                "clinician",
                "contractor",
                "other"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "followUpOn": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "programId",
        "findingId",
        "title",
        "kind",
        "state",
        "responsiblePerson",
        "dueOn",
        "revision",
        "assigneeUserId",
        "needsReview"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "programId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "findingId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "enum": [
            "profile",
            "room_review",
            "documents",
            "contact",
            "draft_review",
            "follow_up",
            "other"
          ]
        },
        "state": {
          "enum": [
            "pending",
            "in_progress",
            "blocked",
            "completed",
            "cancelled"
          ]
        },
        "responsiblePerson": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "dueOn": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "assigneeUserId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "needsReview": {
          "type": "boolean"
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "membershipId",
        "permissionRevision",
        "caseRevision",
        "programId",
        "update",
        "proposedBy",
        "proposedAt",
        "state",
        "reviewedBy",
        "reviewedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "membershipId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "permissionRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "caseRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "programId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "update": {
          "$ref": "#/$defs/update"
        },
        "proposedBy": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "proposedAt": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ]
        },
        "reviewedBy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "caseId",
        "membershipId",
        "caseRevision",
        "permissionRevision",
        "progressRevision",
        "collaborationRevision",
        "canManage",
        "scope",
        "tasks",
        "proposals",
        "acknowledgedMutationId"
      ],
      "properties": {
        "schemaVersion": {
          "const": "3"
        },
        "caseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "membershipId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "caseRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "permissionRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "progressRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "collaborationRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "canManage": {
          "type": "boolean"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "tasks": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/task"
          }
        },
        "proposals": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/proposal"
          }
        },
        "acknowledgedMutationId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "read-collaboration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "membershipId",
        "expectedPermissionRevision"
      ],
      "properties": {
        "schemaVersion": {
          "const": "3"
        },
        "membershipId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expectedPermissionRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "configure-collaboration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "membershipId",
        "expectedPermissionRevision",
        "expectedCaseRevision",
        "expectedCollaborationRevision",
        "mutationId",
        "expectedProgressRevision",
        "collaborationScope",
        "assignedTaskIds"
      ],
      "properties": {
        "schemaVersion": {
          "const": "3"
        },
        "membershipId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expectedPermissionRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expectedCaseRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expectedCollaborationRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mutationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expectedProgressRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "collaborationScope": {
          "$ref": "#/$defs/scope"
        },
        "assignedTaskIds": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true
        }
      }
    },
    "update-shared-task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "membershipId",
        "expectedPermissionRevision",
        "expectedCaseRevision",
        "expectedCollaborationRevision",
        "mutationId",
        "taskId",
        "expectedTaskRevision",
        "state"
      ],
      "properties": {
        "schemaVersion": {
          "const": "3"
        },
        "membershipId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expectedPermissionRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expectedCaseRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expectedCollaborationRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mutationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expectedTaskRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "pending",
            "in_progress",
            "blocked",
            "completed",
            "cancelled"
          ]
        }
      }
    },
    "propose-shared-status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "membershipId",
        "expectedPermissionRevision",
        "expectedCaseRevision",
        "expectedCollaborationRevision",
        "mutationId",
        "programId",
        "update"
      ],
      "properties": {
        "schemaVersion": {
          "const": "3"
        },
        "membershipId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expectedPermissionRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expectedCaseRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expectedCollaborationRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mutationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "programId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "update": {
          "$ref": "#/$defs/update"
        }
      }
    },
    "review-shared-status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "membershipId",
        "expectedPermissionRevision",
        "expectedCaseRevision",
        "expectedCollaborationRevision",
        "mutationId",
        "expectedProgressRevision",
        "proposalId",
        "decision"
      ],
      "properties": {
        "schemaVersion": {
          "const": "3"
        },
        "membershipId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expectedPermissionRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expectedCaseRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expectedCollaborationRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mutationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "expectedProgressRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "proposalId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "decision": {
          "enum": [
            "accepted",
            "rejected"
          ]
        }
      }
    }
  }
}
