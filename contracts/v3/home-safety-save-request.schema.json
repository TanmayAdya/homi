{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-at-home.example/contracts/v3/home-safety-save-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "expectedCaseRevision",
    "expectedSafetyRevision",
    "mutationId",
    "operation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3"
    },
    "caseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "expectedCaseRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expectedSafetyRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mutationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "operation": {
      "$ref": "home-safety.schema.json#/$defs/operation"
    }
  }
}
