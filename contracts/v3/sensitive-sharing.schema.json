{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safeathome.example/contracts/v3/sensitive-sharing.schema.json",
  "title": "Explicit selected-data helper access; independent default-off capability",
  "$defs": {
    "selection": {
      "type": "object",
      "properties": {
        "photoIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 6,
          "uniqueItems": true
        },
        "measurementIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "answerIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "photoIds",
        "measurementIds",
        "answerIds"
      ],
      "additionalProperties": false
    },
    "photo": {
      "type": "object",
      "properties": {
        "evidenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "evidenceRevision": {
          "type": "integer",
          "minimum": 1
        },
        "caseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "findingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "mediaType": {
          "const": "image/png"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "capturedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "preparedAt": {
          "type": "string",
          "format": "date-time"
        },
        "processingVersion": {
          "const": "evidence-png-v1"
        }
      },
      "required": [
        "evidenceId",
        "evidenceRevision",
        "caseId",
        "findingId",
        "mediaType",
        "byteLength",
        "sha256",
        "width",
        "height",
        "capturedAt",
        "preparedAt",
        "processingVersion"
      ],
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "findingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "const": "mm"
        },
        "method": {
          "enum": [
            "manual",
            "estimated"
          ]
        },
        "confirmed": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "findingId",
        "type",
        "value",
        "unit",
        "method",
        "confirmed"
      ],
      "additionalProperties": false
    },
    "answer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "programId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "category": {
          "enum": [
            "financial",
            "health",
            "private"
          ]
        },
        "questionnaireVersion": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "intakeRevision": {
          "type": "integer",
          "minimum": 1
        },
        "value": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "string",
              "maxLength": 600
            }
          ]
        },
        "reviewState": {
          "enum": [
            "reported",
            "unknown"
          ]
        }
      },
      "required": [
        "id",
        "programId",
        "key",
        "label",
        "category",
        "questionnaireVersion",
        "intakeRevision",
        "value",
        "reviewState"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "photos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/photo"
          },
          "maxItems": 192
        },
        "measurements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/measurement"
          },
          "maxItems": 1024
        },
        "answers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/answer"
          },
          "maxItems": 128
        }
      },
      "required": [
        "photos",
        "measurements",
        "answers"
      ],
      "additionalProperties": false
    },
    "list-sensitive-options-request": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "3"
        },
        "membershipId": {
          "type": "string",
          "pattern": "^[a-f0-9-]{36}$"
