        "caseRevision": {
          "type": "integer",
          "minimum": 1
        },
        "catalogRevision": {
          "type": "integer",
          "minimum": 0
        },
        "content": {
          "$ref": "#/$defs/content"
        }
      },
      "required": [
        "schemaVersion",
        "membershipId",
        "permissionRevision",
        "caseId",
        "caseRevision",
        "catalogRevision",
        "content"
      ],
      "additionalProperties": false
    },
    "read-sensitive-sharing-request": {
