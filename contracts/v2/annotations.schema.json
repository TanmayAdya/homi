{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-at-home.example/contracts/v2/annotations.schema.json",
  "title": "Annotations",
  "description": "Review requires all three provenance values; needs_review requires all null. Image replacement/deletion clears marks and review while increasing the annotation revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "caseRevision",
    "catalogRevision",
    "annotation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2"
    },
    "caseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "caseRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "catalogRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "caseId",
        "evidenceId",
        "annotationRevision",
        "evidenceRevision",
        "imageSha256",
        "imageWidth",
        "imageHeight",
        "coordinateSpace",
        "marks",
        "reviewState",
        "reviewedCaseRevision",
        "reviewedAt",
        "reviewedBy"
      ],
      "properties": {
        "schemaVersion": {
          "const": "2"
        },
        "caseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "evidenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "annotationRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evidenceRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "imageSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "imageWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "imageHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "coordinateSpace": {
          "const": "normalized-top-left-1e6"
        },
        "marks": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "rect",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "rect": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  }
                ],
                "items": false,
                "minItems": 4,
                "maxItems": 4
              },
              "label": {
                "type": "string",
                "maxLength": 80
              }
            }
          }
        },
        "reviewState": {
          "enum": [
            "needs_review",
            "reviewed"
          ]
        },
        "reviewedCaseRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewedBy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
