{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-at-home.example/contracts/v2/plan-name-save-request.schema.json",
  "title": "Save private plan name v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "expectedNameRevision",
    "mutationId",
    "name"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2"
    },
    "caseId": {
      "$ref": "#/$defs/id"
    },
    "expectedNameRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "mutationId": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "$ref": "#/$defs/name"
    }
  },
  "description": "CAS on independent name revision. Latest exact mutation retry requires identical name and expected revision equal saved revision minus one. Reset increments revision. Stale/reused mismatched mutation returns PLAN_NAME_CONFLICT.",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\uD800-\\uDFFF])(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"
    },
    "name": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\uD800-\\uDFFF])(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
