{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-at-home.example/contracts/v2/case-list.schema.json",
  "title": "Private named plan page v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cases",
    "nextAfterCaseId"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2"
    },
    "cases": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "caseRevision",
          "name",
          "nameRevision",
          "lastMutationId"
        ],
        "properties": {
          "caseId": {
            "$ref": "#/$defs/id"
          },
          "caseRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "name": {
            "$ref": "#/$defs/name"
          },
          "nameRevision": {
            "$ref": "#/$defs/revision"
          },
          "lastMutationId": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/id"
              }
            ]
          }
        },
        "if": {
          "properties": {
            "nameRevision": {
              "const": 0
            }
          }
        },
        "then": {
          "properties": {
            "name": {
              "type": "null"
            },
            "lastMutationId": {
              "type": "null"
            }
          }
        },
        "else": {
          "properties": {
            "lastMutationId": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "nextAfterCaseId": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/id"
        }
      ]
    }
  },
  "description": "Live keyset page. Runtime checks strictly ascending unique UTF-8 case IDs after the input cursor, rows at most requested limit, and nonnull continuation equal to final ID only on a full page. Includes private name metadata, no profile, findings or resident identity. Reload a case before editing.",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\uD800-\\uDFFF])(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"
    },
    "name": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u202a-\\u202e\\u2066-\\u2069\\uD800-\\uDFFF])(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
