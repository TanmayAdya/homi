{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-at-home.example/contracts/v2/assessment.schema.json",
  "title": "Assessment",
  "description": "Server history is append-only, bounded to 500 events and 256 KiB serialized UTF-8. Revision zero with empty metadata means no v2 provenance exists. assessment.caseRevision can precede current case revision; callers must reconcile stale provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "case",
    "caseFingerprint",
    "catalogRevision",
    "assessment",
    "acknowledgedMutationId"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2"
    },
    "case": {
      "$ref": "../v1/case.schema.json"
    },
    "caseFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "catalogRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "caseId",
        "caseRevision",
        "assessmentRevision",
        "metadata",
        "history"
      ],
      "properties": {
        "schemaVersion": {
          "const": "2"
        },
        "caseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "caseRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "assessmentRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "measurements",
            "reviews"
          ],
          "properties": {
            "measurements": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "findingId",
                  "type",
                  "originalText",
                  "originalUnit",
                  "decimalSeparator",
                  "source",
                  "recorder",
                  "recordedAt"
                ],
                "properties": {
                  "findingId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "originalText": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 40
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "originalUnit": {
                    "enum": [
                      "mm",
                      "cm",
                      "m",
                      "in",
                      "ft",
                      null
                    ]
                  },
                  "decimalSeparator": {
                    "enum": [
                      "point",
                      "comma",
                      null
                    ]
                  },
                  "source": {
                    "enum": [
                      "manual",
                      "estimated",
                      "legacy_unknown"
                    ]
                  },
                  "recorder": {
                    "enum": [
                      "self",
                      "helper",
                      "unknown"
                    ]
                  },
                  "recordedAt": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            },
            "reviews": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "findingId",
                  "state",
                  "note"
                ],
                "properties": {
                  "findingId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "state": {
                    "enum": [
                      "confirmed",
                      "needs_review",
                      "dismissed"
                    ]
                  },
                  "note": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 500
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "history": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mutationId",
              "requestHash",
              "caseRevision",
              "assessmentRevision",
              "recordedAt",
              "recordedBy",
              "changes"
            ],
            "properties": {
              "mutationId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{8,128}$"
              },
              "requestHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "caseRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "assessmentRevision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "recordedAt": {
                "type": "string",
                "format": "date-time"
              },
              "recordedBy": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "changes": {
                "type": "array",
                "maxItems": 602,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "before",
                    "after"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "maxLength": 1024
                    },
                    "before": {},
                    "after": {}
                  }
                }
              }
            }
          }
        }
      }
    },
    "acknowledgedMutationId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
